// prisma/schema.prisma
// Smart School Bus Management System — Prisma ORM Schema
// Database: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BusStatus {
  IDLE
  ON_ROUTE
  STOPPED
  BREAKDOWN
  EMERGENCY
}

enum TripStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  BOARDED
  DROPPED
  ABSENT
  PENDING
}

enum AlertType {
  SOS
  OVERSPEED
  GEOFENCE_EXIT
  GEOFENCE_ENTER
  BREAKDOWN
  ACCIDENT
  MEDICAL
  ROUTE_DEVIATION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  EMAIL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(uuid())
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  buses    Bus[]
  routes   Route[]
  students Student[]
  drivers  Driver[]
  admins   Admin[]
}

model Bus {
  id           String    @id @default(uuid())
  number       String    @unique
  plateNumber  String    @unique
  capacity     Int       @default(40)
  status       BusStatus @default(IDLE)
  currentLat   Float?
  currentLng   Float?
  currentSpeed Float?    @default(0)
  engineHealth Int       @default(100)  // 0-100
  fuelLevel    Int       @default(100)  // 0-100 percent
  lastServiceAt DateTime?
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id])
  driverId     String?   @unique
  driver       Driver?   @relation(fields: [driverId], references: [id])
  routeId      String?
  route        Route?    @relation(fields: [routeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trips           Trip[]
  speedViolations SpeedViolation[]
  alerts          Alert[]
  locations       BusLocation[]
}

model Driver {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  licenseNo    String   @unique
  safetyScore  Int      @default(100) // 0-100
  fatigueLevel Int      @default(0)   // 0-100
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bus             Bus?
  trips           Trip[]
  drivingEvents   DrivingEvent[]
}

model Route {
  id          String   @id @default(uuid())
  name        String
  description String?
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  isActive    Boolean  @default(true)
  totalKm     Float?
  estimatedMins Int?
  createdAt   DateTime @default(now())

  stops Route_Stop[]
  buses Bus[]
  trips Trip[]
}

model Stop {
  id      String  @id @default(uuid())
  name    String
  lat     Float
  lng     Float
  address String?

  routeStops  Route_Stop[]
  attendances Attendance[]
}

model Route_Stop {
  id          String @id @default(uuid())
  routeId     String
  route       Route  @relation(fields: [routeId], references: [id])
  stopId      String
  stop        Stop   @relation(fields: [stopId], references: [id])
  order       Int
  etaMinutes  Int?   // minutes from route start

  @@unique([routeId, order])
}

model Student {
  id         String  @id @default(uuid())
  name       String
  rollNumber String  @unique
  class      String
  section    String
  phone      String?
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  parentId   String?
  parent     Parent? @relation(fields: [parentId], references: [id])
  rfidToken  String? @unique  // digital token simulating RFID
  createdAt  DateTime @default(now())

  attendances Attendance[]
}

model Parent {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  fcmToken  String?  // Firebase Cloud Messaging token
  createdAt DateTime @default(now())

  students      Student[]
  notifications Notification[]
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
}

model Trip {
  id          String     @id @default(uuid())
  busId       String
  bus         Bus        @relation(fields: [busId], references: [id])
  driverId    String
  driver      Driver     @relation(fields: [driverId], references: [id])
  routeId     String
  route       Route      @relation(fields: [routeId], references: [id])
  status      TripStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  studentCount Int       @default(0)
  createdAt   DateTime   @default(now())

  attendances Attendance[]
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  tripId    String
  trip      Trip             @relation(fields: [tripId], references: [id])
  stopId    String?
  stop      Stop?            @relation(fields: [stopId], references: [id])
  status    AttendanceStatus @default(PENDING)
  boardedAt DateTime?
  droppedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([studentId, tripId])
}

model BusLocation {
  id        String   @id @default(uuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id])
  lat       Float
  lng       Float
  speed     Float    @default(0)
  heading   Float?
  timestamp DateTime @default(now())

  @@index([busId, timestamp])
}

model SpeedViolation {
  id        String   @id @default(uuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id])
  speed     Float
  limit     Float    @default(40)
  lat       Float
  lng       Float
  timestamp DateTime @default(now())
}

model DrivingEvent {
  id          String   @id @default(uuid())
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id])
  eventType   String   // SUDDEN_BRAKE, SHARP_TURN, OVERSPEED, FATIGUE
  severity    Int      // 1-10
  lat         Float?
  lng         Float?
  timestamp   DateTime @default(now())
}

model Alert {
  id          String        @id @default(uuid())
  busId       String
  bus         Bus           @relation(fields: [busId], references: [id])
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  message     String
  lat         Float?
  lng         Float?
  isResolved  Boolean       @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
}

model Notification {
  id        String              @id @default(uuid())
  parentId  String
  parent    Parent              @relation(fields: [parentId], references: [id])
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  isRead    Boolean             @default(false)
  sentAt    DateTime            @default(now())
}
